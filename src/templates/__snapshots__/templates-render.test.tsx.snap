exports[`templates TESTIMONIALS2 should render the OA v2 sample unchanged 1`] = `
[
  "<div class="css-Container e1bocjee0"><div class="css-PrintWatermark"></div><div class="css-Page e1bocjee1"><div class="css-TestimonialTemplate2"></div><div class="css-TestimonialTemplate2"><p class="css-TestimonialTemplate2">November 22, 2019</p><div class="text-justify"><p>To Whom it May Concern:</p><p>I am pleased to write a letter of recommendation for Cindy Neo Ai Ling.</p><p>I have known Cindy for over three years during which time she worked as an Administrative Assistant in my office. Throughout her time with our organization, she demonstrated critical skills that would make her an excellent employee at your company.</p><p>Cindy is both very bright and motivated. I am confident that she will devote herself to a position with your organization with a high degree of diligence. She is a quick learner and has shown the ability to digest large volumes of information.</p><p>Cindy was always willing to offer her assistance and had an excellent rapport with clients, employers,and other organizations.</p><p>I recommend Cindy without reservation. She would be an asset to any employer, and I wholeheartedly recommend her for any endeavour she chooses to pursue. Please let me know if you have need for additional information about this outstanding lady.</p><p>Sincerely</p></div><div><div><img src="data:image/jpeg;base64," class="css-TestimonialTemplate2"></div><div>Raymond Tan</div><div>Director</div><div>Mobile: 8123-4567</div><div>Email: raymond_tan@123.com.sg</div></div></div><div class="css-TestimonialTemplate2"><div class="css-TestimonialTemplate2">123 Pte Ltd | 88 Robinson Road #08-88 Singapore 000888</div></div></div></div>",
]
`;
